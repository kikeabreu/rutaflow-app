DISABLE_ESLINT_PLUGIN=true
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
# URL publica estable donde viven /api/groq y /api/geocode para el APK.
REACT_APP_API_BASE_URL=https://app.ruleto.mx
# Vercel tambien puede usar NEXT_PUBLIC_SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY.
GROQ_API_KEY=
REACT_APP_STRIPE_PAYMENT_LINK=
REACT_APP_MERCADOPAGO_PAYMENT_LINK=
# Solo Vercel/server-side: nunca usar prefijo REACT_APP_ para estos secretos.
META_DATASET_ID=
META_ACCESS_TOKEN=
# Opcional para pruebas en Events Manager; dejar vacío en producción.
META_TEST_EVENT_CODE=
# Opcional: usar una versión Graph explícita; el endpoint usa v26.0 por defecto.
META_GRAPH_API_VERSION=v26.0
